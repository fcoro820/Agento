{
  "name": "agento",
  "version": "1.0.0",
  "description": "Local CLI-only AI coding assistant powered by Ollama.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agento": "./bin/agento.js",
    "agento-tui": "./bin/agento-tui.js"
  },
  "scripts": {
    "test": "node --test test/agento.test.js",
    "doctor": "node bin/agento.js doctor",
    "ask": "node scripts/ask.js",
    "dev": "node bin/agento.js",
    "tui": "node bin/agento-tui.js",
    "ollama": "node bin/ollama.js",
    "ollama:serve": "node bin/ollama.js serve",
    "ollama:run": "node bin/ollama.js run",
    "ollama:models": "node bin/ollama.js models",
    "ollama:stop": "node bin/ollama.js stop"
  }
}
